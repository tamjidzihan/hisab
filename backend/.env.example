# Server Environment
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Database Configuration (MySQL / MariaDB or SQLite fallback)
# Set DB_DIALECT=mysql to use MariaDB/MySQL. Defaults to sqlite if not configured.
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hisab_finance_tracker
DB_USER=root
DB_PASSWORD=

# Session & JWT Configuration
JWT_SECRET=hisab_master_draftsman_jwt_secret_key_2026_ledger
SESSION_COOKIE_NAME=hisab_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# File Uploads
MAX_RECEIPT_SIZE_MB=5
UPLOAD_DIR=./uploads

